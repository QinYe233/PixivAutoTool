{
  "name": "pixiv-auto-tool",
  "version": "0.1.0",
  "description": "Pixiv 批量下载工具 - 搜索、预览、批量下载",
  "main": "./out/main/index.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "test": "node --experimental-vm-modules --test",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "pack": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder"
  },
  "dependencies": {
    "adm-zip": "^0.5.18",
    "gif-encoder-2": "^1.0.5",
    "jimp": "^1.6.1",
    "undici": "^6.28.0"
  },
  "devDependencies": {
    "@electron/fuses": "^1.8.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "javascript-obfuscator": "^4.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.pixiv.autotool",
    "productName": "PixivAutoTool",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "files": [
      "out/**/*"
    ],
    "afterPack": "./scripts/afterPack.cjs",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
